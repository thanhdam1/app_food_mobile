<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Title and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎁 Điểm Danh Hằng Ngày"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseCheckinDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập mỗi ngày để nhận điểm thưởng &amp; quà tặng VIP!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Streak Indicator Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFF3E0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvDialogCheckinStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Chuỗi 3 ngày liên tiếp"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 7-Day Streak Scroll/Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDialogDaysContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Day 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay1"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 1"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+10đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay2"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 2"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+20đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay3"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 3"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+30đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay4"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 4"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+40đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 5 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay5"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 5"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+50đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 6 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay6"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_light"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 6"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvDayIcon6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪙"
                            android:textSize="16sp"
                            android:layout_marginVertical="2dp" />
                        <TextView
                            android:id="@+id/tvDayPoints6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+60đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mamzi_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Day 7 Special -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDay7"
                    android:layout_width="68dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#FFB300"
                    app:cardBackgroundColor="#FFFDE7">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tvDayLabel7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày 7"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#F57F17" />
                        <TextView
                            android:id="@+id/tvDayIcon7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎁"
                            android:textSize="18sp"
                            android:layout_marginVertical="1dp" />
                        <TextView
                            android:id="@+id/tvDayPoints7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+100đ"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#E65100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Check-in Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDailyCheckin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="🎁 Điểm Danh Nhận Thưởng Ngay"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/mamzi_green"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Subtitle Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Điểm danh liên tục 7 ngày để mở khóa Voucher giảm 50% và tích lũy điểm thăng hạng!"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>