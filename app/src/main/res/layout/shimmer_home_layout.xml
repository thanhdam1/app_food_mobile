<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_light">

    <!-- Header Shimmer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/gray_light" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <View
                android:layout_width="100dp"
                android:layout_height="12dp"
                android:background="@color/gray_light" />
            <View
                android:layout_width="150dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:background="@color/gray_light" />
        </LinearLayout>
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/gray_light" />
    </LinearLayout>

    <!-- Search Bar Shimmer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@color/gray_light" />

    <!-- Categories Shimmer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:weightSum="4">
        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@color/gray_light"/>
        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@color/gray_light"/>
        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@color/gray_light"/>
        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:background="@color/gray_light"/>
    </LinearLayout>

    <!-- Flash Sale Title Shimmer -->
    <View
        android:layout_width="140dp"
        android:layout_height="20dp"
        android:layout_marginTop="24dp"
        android:background="@color/gray_light" />

    <!-- Flash Sale Items Shimmer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <View android:layout_width="140dp" android:layout_height="160dp" android:layout_marginEnd="12dp" android:background="@color/gray_light"/>
        <View android:layout_width="140dp" android:layout_height="160dp" android:layout_marginEnd="12dp" android:background="@color/gray_light"/>
        <View android:layout_width="140dp" android:layout_height="160dp" android:background="@color/gray_light"/>
    </LinearLayout>

    <!-- Best Seller List Shimmer -->
    <View
        android:layout_width="120dp"
        android:layout_height="20dp"
        android:layout_marginTop="24dp"
        android:background="@color/gray_light" />

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@color/gray_light" />
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@color/gray_light" />

</LinearLayout>
