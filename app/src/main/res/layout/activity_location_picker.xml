<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarLocationPicker"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/mamzi_green"
            app:title="Đổi Định Vị &amp; Ghim Bản Đồ"
            app:titleTextColor="@color/white"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Quick Location Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPresetNguyenHue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Phố Nguyễn Huệ"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F1F3F4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipPresetBitexco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 Bitexco Tower"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F1F3F4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipPresetVincom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏬 Vincom Đồng Khởi"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F1F3F4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipPresetBenThanh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 Chợ Bến Thành"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F1F3F4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipPresetPark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 Công viên 23/9"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F1F3F4"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Map Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <vn.edu.vhu.app_eat.ui.tracking.InteractivePinMapView
            android:id="@+id/interactiveMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Instruction Pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="👆 Chạm hoặc kéo ghim đỏ để chọn vị trí"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@color/black"
            android:backgroundTint="#B3000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <!-- Floating GPS Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            app:fabSize="mini"
            app:backgroundTint="@color/white"
            app:tint="@color/mamzi_green"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="My Location" />

    </RelativeLayout>

    <!-- Pinned Location Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 "
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPinnedAddressTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123 Nguyễn Huệ, Bến Nghé, Quận 1, TP.HCM"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvPinnedCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS: 10.7765° N, 106.7009° E • Quận 1"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Note / Detail Field -->
            <EditText
                android:id="@+id/etAddressDetail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_discount"
                android:backgroundTint="#F5F5F5"
                android:hint="Thêm ghi chú (Số tầng, phòng, cửa ra vào...)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="14dp"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <!-- Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmPinLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="✅ Xác Nhận Ghim Địa Chỉ Này"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/mamzi_green"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>